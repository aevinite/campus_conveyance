# Copy to .env.local and fill in. Never commit the real .env.local.

# ── Supabase (client + server) ──────────────────────────────────────────────
# From the Supabase project's API settings.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service-role key — SERVER ONLY, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL of the app (used for OAuth redirect + email links).
# Local dev: http://localhost:3000 ; prod: https://your-domain
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Outbound email (Gmail + Nodemailer) ─────────────────────────────────────
# Gmail address used as the sender, and a Google "app password" (not the login
# password). Used for password-reset / signup-confirmation / contact mails.
GMAIL_SENDER=you@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
# Where the landing-page contact form is delivered (defaults to GMAIL_SENDER).
CONTACT_INBOX=you@gmail.com

# ── DB provisioning scripts only (npm run db:provision) ─────────────────────
# Supabase Management API access token + project ref. Not needed to run the app.
SUPABASE_ACCESS_TOKEN=your-management-api-token
SUPABASE_PROJECT_REF=your-project-ref

# ── Auto-injected by Vercel (do NOT set by hand) ────────────────────────────
# `vercel dev` / `vercel env pull` writes VERCEL_OIDC_TOKEN into .env.local for
# OIDC federation. Listed here only so its presence isn't a surprise; leave unset
# locally unless you use Vercel's OIDC features.
# VERCEL_OIDC_TOKEN=
