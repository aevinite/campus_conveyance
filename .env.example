# Campus Conveyance — environment variables.
# Copy to .env.local and fill in. NEVER commit real values.
# In production these are set in the Vercel project settings.

# --- Supabase (app runtime) -------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Also the bearer the drain-outbox pg_cron job sends to
# /api/cron/drain (stored in Supabase Vault as 'service_role_key').
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase Management API (scripts/migrate.mjs, provisioning; not used at runtime)
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=

# --- Site URL -----------------------------------------------------------------
# Public origin used in emailed links, metadata, robots and sitemap. Optional:
# falls back to VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL (set by Vercel), then
# https://campus-conveyance.vercel.app (see src/lib/site-url.ts).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email (Gmail SMTP via Nodemailer) --------------------------------------
GMAIL_SENDER=
GMAIL_APP_PASSWORD=
# Optional: where contact-form messages are forwarded (defaults to GMAIL_SENDER).
CONTACT_INBOX=

# --- Web push (VAPID) -------------------------------------------------------
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Maps -------------------------------------------------------------------
# Optional MapTiler key for clean tiles; keyless OSM fallback when empty.
NEXT_PUBLIC_MAPTILER_KEY=

# --- Vercel CLI (written by `vercel env pull`; not needed locally) ----------
VERCEL_OIDC_TOKEN=
